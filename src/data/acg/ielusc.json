  "regras_gerais": [
    { "texto": "Mínimo de 3 modalidades de atividades distintas.", "fonte": "Res. CES 53/2026, art. 1º, § 2º" },
    { "texto": "No mínimo 10% da carga de ACGs do curso em atividades de cunho social organizadas pela IES, preferencialmente de extensão.", "fonte": "Res. CES 53/2026, art. 1º, § 4º" },
    { "texto": "Ação comunitária feita dentro de disciplina só vale se transcender a carga regular da disciplina ou ocorrer em horário extraclasse.", "fonte": "Res. CES 53/2026, art. 2º" },
    { "texto": "Trabalho eleitoral tem horas fixas, iguais em todos os cursos: mesário 10 h; apurador 4 h; delegado de prédio 13 h; auxiliar de secretaria 6 h; motorista 8 h; auxiliar de serviço eleitoral 8 h.", "fonte": "Res. CES 53/2026, art. 3º" },
    { "texto": "As tabelas não incluem pontuação específica para atividades de cunho social; o relatório em formulário anexo é obrigatório para elas.", "fonte": "Res. CES 53/2026, arts. 4º e 5º" }
  ],
